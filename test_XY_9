def get_U(a, b, g):
    N1 = N
    pauli_x = torch.tensor([[0., 1.], [1., 0.]], dtype=torch.complex64).to(device)
    identity = torch.tensor([[1., 0.], [0., 1.]], dtype=torch.complex64).to(device)
    pauli_z = torch.tensor([[1., 0.], [0., -1.]], dtype=torch.complex64).to(device)

    U = torch.eye(2**N1, dtype=torch.complex64).to(device)

    for i in range(N1):
        pz = [pauli_z if j == i else identity for j in range(N1)]
        px = [pauli_x if j == i else identity for j in range(N1)]

        result_z = reduce(torch.kron, pz).to(device)
        result_x = reduce(torch.kron, px).to(device)

        del px
        del pz
        U = torch.matmul(
            (torch.cos((g[i])) * torch.eye(2**N1).to(device) - 1j * torch.sin((g[i])) * result_z),
            torch.matmul(
                (torch.cos((b[i])) * torch.eye(2**N1).to(device) - 1j * torch.sin((b[i])) * result_x),
                torch.matmul(
                    (torch.cos((a[i])) * torch.eye(2**N1).to(device) - 1j * torch.sin((a[i])) * result_z),
                    U
                )
            )
        )
        del result_x
        del result_z
    
    return U


def evolution(time, params):

    # gc.collect()
    # global ham
    N1 = N
    L= L1
    # print("L:",L)
    a = params[0]
    b = params[1]
    g = params[2]
    complex_const = -1j
    ham = (complex_const * time)*(matrix - matrix2 + matrix3)
    H = ham.matrix_exp()
    H = H.to(device)

    U_final = torch.eye(2**N1, dtype=torch.complex64).to(device)
    for l in range(L):        
        U1 = get_U(a[l][0],b[l][0],g[l][0]).to(device)
        U2 = get_U(a[l][1],b[l][1],g[l][1]).to(device)
        U_final = torch.matmul(torch.matmul(torch.matmul(U2, H), U1), U_final)
        del U1
        del U2
        # gc.collect()

    return U_final

def manual_kron(A, B):
    """
    Manually compute the Kronecker product of two matrices A and B.
    """
    assert A.dim() == 2 and B.dim() == 1, "A should be a matrix and B should be a vector"
    
    m, n = A.size()
    p = B.size(0)
    
    C = torch.zeros(m * p, n, device=A.device, dtype=A.dtype)
    
    for i in range(m):
        for j in range(n):
            C[i*p:(i+1)*p, j] = A[i, j] * B
    
    return C

def expectation(state,time,params):
    state = state.to(device).contiguous()
    state = manual_kron(state, torch.tensor([1., 0.], device=device)).contiguous()
    # state = (torch.kron(state, torch.tensor([1.,0.]).to(device))).to(device)
    with torch.no_grad():
        U = evolution(time,params)
    # pdb.set_trace()
    state = U @ state
    del U
    state = torch.abs(state) ** 2
    exp0 = torch.sum(state[::2], axis = 0)
    exp1 = torch.sum(state[1::2], axis = 0)
    expt = exp0 - exp1
    # print("here")
    # pdb.set_trace()
    return expt


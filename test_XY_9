class QuantumPerceptron(nn.Module):
    def __init__(self, input_size, hidden_size, output_size):
        super(QuantumPerceptron, self).__init__()
        self.layer1 = nn.Linear(input_size, output_size).to(device)
        L= L1
        N1 = N
        a = torch.normal(mean=0.0, std=1., size=[L, 2, N1]).to(device)
        b = torch.normal(mean=0.0, std=1., size=[L, 2, N1]).to(device)
        g = torch.normal(mean=0.0, std=1., size=[L, 2, N1]).to(device)
        self.params = nn.Parameter(torch.zeros_like(torch.stack((a, b, g))))
        self.params.requires_grad = True

    def init_r(self, state):
        self.r = []
        for t in torch.arange(0.0, 0.1, 0.01).to(device):
            expectations = expectation(state, t, self.params)
            # pdb.set_trace()
            self.r.append(expectations)
        # pdb.set_trace()
        self.r = torch.stack(self.r).contiguous()
        return self.r
    
    # def evolve(self, state):
    #     self.r = []
    #     for t in torch.arange(0.0, 1.0, 0.05).to(device):
    #         state_final, expectations = expectation(state, t, self.params)
    #         self.r.append(state_final)
    #     self.r = torch.stack(self.r)
    #     return self.r

    def forward(self, state):
        final_state = self.init_r(state)
        # pdb.set_trace()
        self.r = final_state.to(torch.float32).to(device)
        self.r = self.r.transpose(0,1)
        out = self.layer1(self.r)
        out = F.tanh(out)
        return out

